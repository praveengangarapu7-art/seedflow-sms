+}
+
+@media (max-width: 991px) {
+  .headline {
+    text-align: center;
+  }
+}
+
+.line {
+  display: block;
+}
+
+@media (min-width: 992px) {
+  .line {
+    white-space: nowrap;
+  }
+}
+
+.goldText {
