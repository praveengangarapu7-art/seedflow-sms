+              value={searchTerm}
+              onChange={e => setSearchTerm(e.target.value)}
+              className={styles.searchInput}
+            />
+          </div>
+
+          <select
+            value={growthStageFilter}
+            onChange={e => setGrowthStageFilter(e.target.value)}
