+/* Deep azure to close the page on the same colour as the CTA directly above,
+   rather than dropping back to white for the last screenful. Every text tone
+   below is therefore white-alpha, not the app's dark-on-light text tokens. */
+.footer {
+  background-color: var(--landing-footer-bg);
+  border-top: 1px solid rgba(255, 255, 255, 0.12);
+  padding: 48px 24px 28px 24px;
+  position: relative;
+  z-index: 5;
+}
+
+.container {
+  max-width: 1280px;
+  margin: 0 auto;
+}
+
+/* Grid columns */
+.grid {
+  display: grid;
+  grid-template-columns: 2fr repeat(3, 1fr);
+  gap: 48px;
+  margin-bottom: 36px;
+}
+
+@media (max-width: 991px) {
+  .grid {
+    grid-template-columns: repeat(2, 1fr);
+    gap: 40px;
+  }
+}
+
+@media (max-width: 599px) {
+  .grid {
+    grid-template-columns: 1fr;
+    gap: 36px;
+  }
+}
+
+/* Brand column Details */
+.brandCol {
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+  max-width: 320px;
+}
+
+.brand {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  text-decoration: none;
+  margin-bottom: 16px;
+}
+
+.sphereIcon {
+  color: var(--color-warning);
+  width: 24px;
+  height: 24px;
+}
+
+.wordmark {
+  color: var(--color-white);
+  font-weight: 800;
+  font-size: 18px;
+  letter-spacing: -0.5px;
+}
+
+.tagline {
+  font-size: 14px;
+  line-height: 1.5;
+  color: rgba(255, 255, 255, 0.68);
+}
+
+/* Link Columns */
+.columnTitle {
+  font-size: 14px;
+  font-weight: 700;
+  color: rgba(255, 255, 255, 0.92);
+  text-transform: uppercase;
+  letter-spacing: 1.5px;
+  margin: 0 0 20px 0;
+}
+
+.linksList {
+  list-style: none;
+  padding: 0;
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+}
+
+.link {
+  font-size: 14px;
+  color: rgba(255, 255, 255, 0.68);
+  text-decoration: none;
+  transition: color 200ms ease;
+  cursor: pointer;
+}
+
+.link:hover {
+  color: var(--color-white);
+}
+
+/* Bottom footer row details */
+.bottomRow {
+  border-top: 1px solid rgba(255, 255, 255, 0.12);
+  padding-top: 32px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  flex-wrap: wrap;
+  gap: 20px;
+}
+
+@media (max-width: 599px) {
+  .bottomRow {
+    flex-direction: column;
+    text-align: center;
+  }
+}
+
+.copyright {
+  font-size: 13px;
+  color: rgba(255, 255, 255, 0.55);
+  font-weight: 500;
+}
+
+.socials {
+  display: flex;
+  align-items: center;
+  gap: 16px;
+}
+
+.socialLink {
+  color: rgba(255, 255, 255, 0.6);
+  transition: color 200ms ease, transform 200ms ease;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.socialLink:hover {
+  color: var(--color-white);
+  transform: translateY(-1px);
+}
+
+/* Bottom Stats Horizontal Strip (above copyright row) */
+.statsStrip {
+  border-top: 1px solid rgba(255, 255, 255, 0.12);
+  padding-top: 48px;
+  margin-bottom: 48px;
+  display: grid;
+  grid-template-columns: repeat(4, 1fr);
+  gap: 24px;
+  text-align: center;
+}
+
+@media (max-width: 768px) {
+  .statsStrip {
+    grid-template-columns: repeat(2, 1fr);
+    gap: 36px;
+  }
+}
+
+.statItem {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+  position: relative;
+}
+
+/* Gold dividers between stat items (desktop only) */
+@media (min-width: 769px) {
+  .statItem:not(:last-child)::after {
+    content: '';
+    position: absolute;
+    top: 15%;
+    right: -12px;
+    height: 70%;
+    width: 2px;
+    background-color: var(--color-warning);
+    opacity: 0.5;
+  }
+}
+
+.statVal {
+  font-size: clamp(24px, 3.5vw, 28px);
+  font-weight: 800;
+  color: var(--color-white);
+  line-height: 1;
+}
+
+.statLbl {
+  font-size: 13px;
+  font-weight: 600;
+  color: rgba(255, 255, 255, 0.6);
+  text-transform: uppercase;
+  letter-spacing: 0.5px;
+}
