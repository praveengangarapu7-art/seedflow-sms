+            </div>
+          </div>
+          <div className={styles.inputGroup}>
+            <label>Priority</label>
+            <div className={styles.radioGrid}>
+              {['Low', 'Medium', 'High'].map(p => (
+                <label key={p} className={styles.radioLabel}>
+                  <input 
+                    type="radio" 
+                    name="priority" 
+                    checked={formData.priority === p}
