+.ctaSection {
+  /* Deep azure, but graded rather than flat so it reads as the same family as
+     the tinted bands above it instead of a solid slab. */
+  background-color: var(--color-primary);
+  background-image: linear-gradient(135deg, #106075 0%, var(--color-primary) 45%, #093846 100%);
+  color: var(--color-white);
+  padding: 52px 24px;
+  position: relative;
+  overflow: hidden;
+  z-index: 5;
+  text-align: center;
+}
+
+.container {
+  max-width: 800px;
+  margin: 0 auto;
+  position: relative;
+  z-index: 10;
+}
+
+/* Heading structures */
+.title {
+  font-size: clamp(28px, 4vw, 40px);
+  font-weight: 800;
+  color: var(--color-white);
+  margin: 0 0 16px 0;
+  line-height: 1.2;
+}
+
+.subtitle {
+  font-size: 18px;
+  line-height: 1.6;
+  color: rgba(255, 255, 255, 0.85);
+  margin-bottom: 28px;
+  font-weight: 500;
+}
+
+/* CTAs Alignment */
+.actions {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 20px;
+  flex-wrap: wrap;
+}
+
+.primaryBtn {
+  background-color: var(--color-warning);
+  color: var(--color-text-primary);
+  font-weight: 700;
+  font-size: 16px;
+  padding: 14px 32px;
+  border-radius: 50px;
+  border: none;
+  cursor: pointer;
+  text-decoration: none;
+  box-shadow: 0 4px 14px rgba(245, 175, 18, 0.25);
+  transition: all 200ms cubic-bezier(0.16, 1, 0.3, 1);
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.primaryBtn:hover {
+  transform: translateY(-2px);
+  background-color: #f7b71d;
+  box-shadow: 0 6px 20px rgba(245, 175, 18, 0.38);
+}
+
+.secondaryBtn {
+  background-color: transparent;
+  color: var(--color-white);
+  border: 2px solid rgba(255, 255, 255, 0.5);
+  font-weight: 700;
+  font-size: 16px;
+  padding: 12px 30px;
+  border-radius: 50px;
+  cursor: pointer;
+  text-decoration: none;
+  transition: all 200ms ease;
+  display: inline-flex;
+  align-items: center;
+}
+
+.secondaryBtn:hover {
+  background-color: var(--color-white);
+  color: var(--color-primary);
+  border-color: var(--color-white);
+  transform: translateY(-1px);
+}
+
+/* Rotating SVG background sphere outline */
+.bgSphereSvg {
+  position: absolute;
+  top: 50%;
+  right: -250px;
+  transform: translateY(-50%);
+  width: 600px;
+  height: 600px;
+  pointer-events: none;
+  z-index: 1;
+  opacity: 0.05;
+  animation: rotateSphere 80s infinite linear;
+}
+
+@keyframes rotateSphere {
+  from { transform: translateY(-50%) rotate(0deg); }
+  to { transform: translateY(-50%) rotate(360deg); }
+}
