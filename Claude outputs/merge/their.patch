+          <ScoreRing key={i} score={val} size="sm" />
+        ))}
+      </div>
+    );
+  }
+
+  if (type === 'bar') {
+    const max = Math.max(...data, 1);
+    return (
+      <svg viewBox="0 0 120 60" className={styles.svg}>
+        {data.map((val, i) => {
