+
+  const handleAction = (action: string, reg: VarietyRegistration) => {
+    if (action === 'submit') {
+      update(reg.id, { 
+        status: 'Submitted', 
+        filedDate: new Date().toISOString().split('T')[0],
+        timeline: [
