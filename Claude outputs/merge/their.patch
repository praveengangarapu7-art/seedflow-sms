+    { key: 'Approved', label: `Approved (${tabCounts.Approved})` },
+    { key: 'Granted', label: `Granted (${tabCounts.Granted})` },
+    { key: 'Rejected', label: `Rejected (${tabCounts.Rejected})` },
+    { key: 'Expired', label: `Expired (${tabCounts.Expired})` },
