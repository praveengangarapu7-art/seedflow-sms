+.heroSection {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  /* 80vh left dead air below the artwork on a laptop; the content itself is
+     the floor now, with just enough min-height to stay generous on short
+     viewports. Top padding clears the 72px fixed nav. */
+  min-height: 560px;
+  max-width: 1360px; /* Increased to allow premium spacing */
+  margin: 0 auto;
+  padding: 96px 24px 56px 24px;
+  gap: 48px;
+  position: relative;
+  z-index: 10;
+}
+
+@media (max-width: 991px) {
+  .heroSection {
+    flex-direction: column-reverse;
+    padding-top: 100px;
+    gap: 40px;
+    text-align: center;
+  }
+}
+
+.leftColumn {
+  flex: 1.25; /* Allow more horizontal layout space for text */
+  max-width: 780px; /* Widened to support single-line title bounds */
+  display: flex;
+  flex-direction: column;
+  align-items: flex-start;
+}
+
+@media (max-width: 991px) {
+  .leftColumn {
+    align-items: center;
+    max-width: 100%;
+  }
+}
+
+.rightColumn {
+  flex: 0.85; /* Maintain compact bounds for infographic */
+  width: 100%;
+  max-width: 500px; /* Lock max width to avoid crowding left column */
+  display: flex;
+  justify-content: center;
+  align-items: center;
+}
+
+/* Staggered load animation keyframes */
+.fadeInUp {
+  opacity: 0;
+  transform: translateY(30px);
+  animation: fadeInUpKey 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
+}
+
+@keyframes fadeInUpKey {
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+/* Badge Pill */
+.badgePill {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding: 6px 14px;
