+            <span>AI quality forecasts</span>
+          </div>
+        </div>
+      </div>
+
+      {/* Right Visual centerpiece */}
+      <div className={`${styles.rightColumn} ${styles.fadeInUp}`} style={{ animationDelay: '300ms' }}>
+        <SeedJourney />
+      </div>
+    </section>
+  );
+}
