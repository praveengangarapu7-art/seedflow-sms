+    assignedTo: '',
+    priority: 'Medium',
+    estimatedDuration: '1'
+  });
+
+  const handleSubmit = (e: React.FormEvent) => {
+    e.preventDefault();
+    onSchedule(formData);
+    onClose();
+  };
+
+  return (
+    <Modal isOpen={isOpen} onClose={onClose} title="Schedule maintenance" size="lg">
+      <form className={styles.form} onSubmit={handleSubmit}>
