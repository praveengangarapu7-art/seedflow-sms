+.st_Dispatched   { background-color: rgba(45, 122, 143, 0.18); color: var(--color-info); }
+.st_In_transit   { background-color: rgba(230, 188, 66, 0.2);  color: var(--color-warning); }
+.st_Delivered    { background-color: rgba(46, 139, 92, 0.18); color: var(--color-success); }
+
+.section { margin-bottom: 16px; }
+.sectionTitle {
+  font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em;
+  color: var(--color-text-muted); font-weight: 600; margin-bottom: 10px;
+}
+
+.timeline {
+  list-style: none;
+  position: relative;
+  padding-left: 8px;
+}
+
+.timeline::before {
+  content: '';
+  position: absolute;
+  left: 13px;
+  top: 12px;
+  bottom: 12px;
+  width: 2px;
+  background-color: var(--color-border);
+}
+
+.timelineItem {
+  display: flex;
+  gap: 10px;
+  padding: 6px 0;
+  position: relative;
+  z-index: 1;
+}
+
+.timelineDot {
+  width: 28px; height: 28px;
+  border-radius: 50%;
+  background-color: var(--color-white);
+  border: 2px solid var(--color-border);
+  display: flex; align-items: center; justify-content: center;
+  flex-shrink: 0;
+  color: var(--color-text-muted);
+}
+
+.timelinePip { width: 6px; height: 6px; border-radius: 50%; background-color: var(--color-border); }
+
+.state_done .timelineDot {
+  background-color: var(--color-success);
+  border-color: var(--color-success);
+  color: var(--color-white);
+}
+
+.state_current .timelineDot {
+  background-color: var(--color-primary);
+  border-color: var(--color-primary);
+  color: var(--color-white);
+}
+
+.timelineBody {
+  display: flex; flex-direction: column; gap: 2px; padding-top: 4px;
+  font-size: 13px;
+}
+
+.timelineLabel { color: var(--color-text-primary); font-weight: 500; }
+.timelineDetail { color: var(--color-text-secondary); font-size: 12px; }
+.timelineStamp { color: var(--color-text-muted); font-size: 11px; }
+
+.state_pending .timelineLabel { color: var(--color-text-muted); }
+
+.vehicleCard {
+  background-color: var(--color-accent-light);
+  border-radius: var(--radius-md);
+  padding: 10px 14px;
+  display: flex; flex-direction: column; gap: 4px;
+}
+
+.vehicleRow {
+  display: flex; justify-content: space-between;
+  font-size: 13px;
+  padding: 4px 0;
+  border-bottom: 1px dashed var(--color-border-light);
+}
+.vehicleRow:last-child { border-bottom: none; }
+.vehicleRow span { color: var(--color-text-muted); }
+.vehicleRow strong { color: var(--color-text-primary); font-weight: 600; }
+
+.mapPlaceholder {
+  background-color: var(--color-accent-light);
+  border: 1px dashed var(--color-border);
+  border-radius: var(--radius-md);
+  padding: 36px 20px;
+  display: flex; flex-direction: column; align-items: center; gap: 8px;
+  color: var(--color-text-secondary);
+  font-size: 12px;
+  margin-bottom: 14px;
+}
+
+.footer {
+  display: flex; justify-content: space-between; gap: 8px;
+  padding-top: 14px; border-top: 1px solid var(--color-border-light);
+  flex-wrap: wrap;
+}
+
+.footerRight { display: flex; gap: 8px; flex-wrap: wrap; }
+
+@media (max-width: 768px) {
+  .footer { flex-direction: column; align-items: stretch; }
+  .footerRight { flex-direction: column; }
+}
