+            type="number"
+            className={styles.input}
+            value={actualQty}
+            min={0}
+            onChange={(e) => setActualQty(e.target.value)}
+          />
+        </label>
+
+        {item && validActual && actualQtyNum > 0 && newQty !== null && (
+          <div className={styles.varianceCard}>
+            <div className={styles.varianceLine}>
