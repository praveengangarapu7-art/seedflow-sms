+const WORKFLOW_STAGE_KEYS = [
+  'FOUNDATION_LOT',
+  'PRE_CERTIFIED_INSPECTION',
+  'CERTIFIED_PRODUCTION',
+  'QUALITY_TESTING',
+  'MARKET_READY_RELEASE',
