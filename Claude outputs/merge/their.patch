+}
+
+@keyframes wordIn {
+  from { transform: translateY(100%); opacity: 0; }
+  to { transform: translateY(0); opacity: 1; }
+}
+
+.rightColumn {
+  flex: 1;
+  max-width: 540px;
+}
+
+/* On phones the message comes first, then the animated seed journey. */
+@media (max-width: 991px) {
+  .heroSection {
+    flex-direction: column;
+  }
+}
