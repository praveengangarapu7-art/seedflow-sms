+}
+
+@keyframes pulseDot {
+  0%, 100% {
+    transform: scale(1);
+    opacity: 1;
+  }
+  50% {
+    transform: scale(1.3);
+    opacity: 0.6;
+  }
+}
+
+/* Typography headline */
+.headline {
+  font-size: clamp(34px, 4.2vw, 52px);
+  font-weight: 800;
+  color: var(--color-text-primary);
