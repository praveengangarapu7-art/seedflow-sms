+.section {
+  padding: 44px 24px;
+  background-color: var(--landing-surface);
+  position: relative;
+  overflow: hidden;
+  z-index: 5;
+}
+
+.container {
+  max-width: 1280px;
+  margin: 0 auto;
+}
+
+/* Header styled items */
+.header {
+  text-align: center;
+  max-width: 720px;
+  margin: 0 auto 32px auto;
+}
+
+.label {
+  font-size: 12px;
+  font-weight: 700;
+  text-transform: uppercase;
+  color: var(--color-warning);
+  letter-spacing: 2px;
+  display: block;
+  margin-bottom: 12px;
+}
+
+.title {
+  font-size: clamp(30px, 4vw, 42px);
+  font-weight: 800;
+  color: var(--color-primary);
+  margin: 0 0 16px 0;
+  line-height: 1.15;
+}
+
+.subtitle {
+  font-size: 17px;
+  line-height: 1.6;
+  color: var(--landing-text-on-tint);
+  margin: 0;
+}
+
+/* Seed Journey Interactive Board */
+.journeyBoard {
+  position: relative;
+  width: 100%;
+  margin: 0 auto 40px auto;
+  min-height: 340px;
+}
+
+/* Desktop horizontal wrapper */
+.desktopWrapper {
+  width: 100%;
+  overflow-x: auto;
+  overflow-y: hidden;
+  padding: 16px 0 32px 0;
+}
+
+.svgTimeline {
+  width: 1000px;
+  height: 250px;
+  display: block;
+  margin: 0 auto;
+  overflow: visible;
+}
+
+/* Traveling seed character doodle */
+.travelingSeed {
+  transition: transform 300ms ease;
+  filter: drop-shadow(0 4px 10px rgba(245, 175, 18, 0.3));
+  cursor: default;
+}
+
+.seedBody {
+  fill: #E0B63F; /* SeedSphere gold */
+}
+
+.seedSpine {
+  stroke: #0E5467; /* Dark Azure */
+  stroke-width: 1.6px;
+  stroke-linecap: round;
+  fill: none;
+}
+
+.seedAccent {
+  stroke: rgba(14, 84, 103, 0.3);
+  stroke-width: 1px;
+  fill: none;
+  stroke-linecap: round;
+}
+
+/* Bouncing wobble animation for traveling seed */
+.seedBounce {
+  animation: seedWobble 0.8s infinite alternate ease-in-out;
+  transform-origin: center;
+}
+
+@keyframes seedWobble {
+  0% {
+    transform: translateY(0) rotate(-6deg);
+  }
+  100% {
+    transform: translateY(-4px) rotate(6deg);
+  }
+}
+
+/* Stage Node elements */
+.stageNode {
+  cursor: pointer;
+  transition: all 400ms cubic-bezier(0.16, 1, 0.3, 1);
+}
+
+.stageBackCircle {
+  fill: var(--color-white);
+  stroke: var(--color-border);
+  stroke-width: 2px;
+  transition: all 400ms ease;
+}
+
+.stageIcon {
+  fill: none;
+  stroke: var(--color-text-muted);
+  stroke-width: 1.5px;
+  transition: all 400ms ease;
+}
+
+/* Active and Past status styles */
+.stageActive .stageBackCircle {
+  fill: rgba(245, 175, 18, 0.15);
+  stroke: var(--color-warning);
+  stroke-width: 3.5px;
+  filter: drop-shadow(0 0 12px rgba(245, 175, 18, 0.25));
+}
+
+.stageActive .stageIcon {
+  stroke: var(--color-warning);
+  stroke-width: 2px;
+}
+
+.stagePast .stageBackCircle {
+  fill: var(--color-primary);
+  stroke: var(--color-primary);
+}
+
+.stagePast .stageIcon {
+  stroke: var(--color-white);
+}
+
+/* Pulsing check dot overlay */
+.pulseCircle {
+  fill: none;
+  stroke: var(--color-warning);
+  stroke-width: 2px;
+  animation: checkpointPulse 1.8s infinite ease-out;
+  transform-origin: center;
+}
+
+@keyframes checkpointPulse {
+  0% {
+    transform: scale(1);
+    opacity: 0.8;
+  }
+  100% {
+    transform: scale(1.6);
+    opacity: 0;
+  }
+}
+
+/* Floating Info Cards positioned absolutely */
+.infoCard {
+  position: absolute;
+  background-color: var(--color-white);
+  border: 1px solid var(--color-border-light);
+  border-radius: var(--radius-md);
+  padding: 12px 16px;
+  box-shadow: var(--shadow-md);
+  width: 220px;
+  text-align: center;
+  z-index: 20;
+  opacity: 0;
+  transform: translateY(12px);
+  pointer-events: none;
+  transition: all 400ms cubic-bezier(0.16, 1, 0.3, 1);
+}
+
+.infoCardVisible {
+  opacity: 1;
+  transform: translateY(0);
+  pointer-events: auto;
+}
+
+.infoTitle {
+  font-size: 14px;
+  font-weight: 800;
+  color: var(--color-primary);
+  margin: 0 0 4px 0;
+}
+
+.infoSub {
+  font-size: 11px;
+  line-height: 1.4;
+  color: var(--color-text-secondary);
+  margin: 0;
+  font-weight: 500;
+}
+
+/* Control actions underneath */
+.controlsRow {
+  display: flex;
+  justify-content: center;
+  align-items: center;
+  gap: 20px;
+  margin-top: -10px;
+  margin-bottom: 36px;
+}
+
+.replayLink {
+  color: var(--color-primary);
+  font-weight: 700;
+  font-size: 14px;
+  text-decoration: none;
+  cursor: pointer;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  background-color: var(--color-white);
+  padding: 8px 16px;
+  border-radius: 50px;
+  transition: all 200ms ease;
+  border: 1px solid rgba(14, 84, 103, 0.1);
+}
+
+.replayLink:hover {
+  background-color: var(--color-primary);
+  color: var(--color-white);
+  transform: translateY(-1px);
+}
+
+/* Mobile Vertical Stack layout */
+.mobileWrapper {
+  display: none;
+}
+
+@media (max-width: 991px) {
+  .desktopWrapper {
+    display: none;
+  }
+  
+  .mobileWrapper {
+    display: flex;
+    flex-direction: column;
+    gap: 40px;
+    max-width: 600px;
+    margin: 0 auto;
+    position: relative;
+    padding-left: 64px;
+  }
+  
+  /* Vertical connector line */
+  .mobileLine {
+    position: absolute;
+    top: 24px;
+    left: 24px;
+    bottom: 24px;
+    width: 2.5px;
+    background-color: var(--color-border);
+    z-index: 1;
+  }
+  
+  .mobileProgressBeam {
+    position: absolute;
+    top: 0;
+    left: 0;
+    width: 100%;
+    height: 0%;
+    background-color: var(--color-warning);
+    box-shadow: 0 0 8px var(--color-warning);
+    transition: height 300ms ease;
+  }
+  
+  .mobileNode {
+    display: flex;
+    align-items: flex-start;
+    gap: 20px;
+    position: relative;
+    z-index: 2;
+  }
+  
+  .mobileBadge {
+    width: 50px;
+    height: 50px;
+    border-radius: 50%;
+    background-color: var(--color-white);
+    border: 3px solid var(--color-border);
+    color: var(--color-text-secondary);
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    font-weight: 800;
+    font-size: 16px;
+    flex-shrink: 0;
+    transition: all 400ms ease;
+  }
+  
+  .mobileNodeActive .mobileBadge {
+    background-color: var(--color-warning);
+    border-color: var(--color-warning);
+    color: var(--color-text-primary);
+    transform: scale(1.08);
+    box-shadow: 0 0 12px rgba(245, 175, 18, 0.3);
+  }
+  
+  .mobileNodePast .mobileBadge {
+    background-color: var(--color-primary);
+    border-color: var(--color-primary);
+    color: var(--color-white);
+  }
+  
+  .mobileCard {
+    background-color: var(--color-white);
+    border: 1px solid var(--color-border-light);
+    border-radius: var(--radius-md);
+    padding: 16px 20px;
+    box-shadow: var(--shadow-sm);
+    flex-grow: 1;
+    transition: border-color 300ms ease;
+  }
+  
+  .mobileNodeActive .mobileCard {
+    border-color: var(--color-warning);
+  }
+  
+  .mobileTitle {
+    font-size: 16px;
+    font-weight: 800;
+    color: var(--color-primary);
+    margin: 0 0 4px 0;
+  }
+  
+  .mobileDesc {
+    font-size: 13px;
+    line-height: 1.5;
+    color: var(--color-text-secondary);
+    margin: 0;
+  }
+}
+
+/* Trust Card at the bottom */
+.trustCard {
+  max-width: 720px;
+  margin: 0 auto;
+  background-color: var(--color-white);
+  border: 1px solid var(--landing-border);
+  border-radius: var(--radius-lg);
+  padding: 40px;
+  box-shadow: var(--shadow-md);
+  display: flex;
+  gap: 24px;
+  align-items: flex-start;
+  position: relative;
+}
+
+@media (max-width: 768px) {
+  .trustCard {
+    flex-direction: column;
+    padding: 24px;
+    gap: 16px;
+    text-align: center;
+    align-items: center;
+  }
+}
+
+.trustIconBox {
+  width: 56px;
+  height: 56px;
+  border-radius: 12px;
+  background-color: rgba(230, 188, 66, 0.1);
+  color: var(--color-warning);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  flex-shrink: 0;
+}
+
+.trustContent {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.trustTitle {
+  font-size: 20px;
+  font-weight: 800;
+  color: var(--color-primary);
+  margin: 0;
+}
+
+.trustBody {
+  font-size: 15px;
+  line-height: 1.6;
+  color: var(--color-text-secondary);
+  margin: 0;
+}
+
+/* Reduced motion constraint overrides */
+@media (prefers-reduced-motion: reduce) {
+  .travelingSeed {
+    display: none !important;
+  }
+  .progressBeam, .mobileProgressBeam {
+    width: 100% !important;
+    height: 100% !important;
+  }
+  .stageBackCircle, .mobileBadge {
+    fill: var(--color-primary) !important;
+    stroke: var(--color-primary) !important;
+    background-color: var(--color-primary) !important;
+    border-color: var(--color-primary) !important;
+    color: var(--color-white) !important;
+  }
+  .stageIcon {
+    stroke: var(--color-white) !important;
+  }
+  .infoCard {
+    opacity: 1 !important;
+    transform: none !important;
+    pointer-events: auto !important;
+  }
+}
