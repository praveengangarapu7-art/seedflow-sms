# Frontend (Vite). Copy to .env.local for local development.
# Local API:            http://localhost:5000/api/v1
# Same-origin (Vercel): leave unset; the Vercel build defaults it to /api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_TIMEOUT_MS=15000

# Demo data fallback when the API is unreachable. Keep false in production.
VITE_DEMO_MODE=false
