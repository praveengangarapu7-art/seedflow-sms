PORT=5000
DATABASE_URL=postgresql://seedflow:seedflow@localhost:5433/seedflow
NODE_ENV=development

# Change this in any real deployment.
JWT_ACCESS_SECRET=dev-access-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

FRONTEND_ORIGIN=http://localhost:5173

# --- AI assistant (optional) ---
# Leave AI_API_KEY empty to run the assistant in deterministic mode: it still
# answers from real database queries, just without an external model.
# AI_PROVIDER accepts: anthropic | openai | gemini | openai-compatible
# openai-compatible needs AI_BASE_URL (e.g. http://localhost:11434/v1 for Ollama) and
# works without an API key for local models.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_FAST_MODEL=
AI_VISION_MODEL=
AI_BASE_URL=
AI_MAX_CONTEXT_ROWS=40

# --- Hosted Postgres (Supabase) ---
# TLS is switched on automatically for supabase.co / pooler.supabase.com URLs.
# Force it on/off for other hosts with DATABASE_SSL=true|false.
# DATABASE_SSL=
# Connections per server instance (default 10; 3 on Vercel).
# DB_POOL_MAX=

# Seed user passwords (required when NODE_ENV=production).
SEED_PASSWORD_ADMIN=
SEED_PASSWORD_BREEDER=
SEED_PASSWORD_PRODUCER=
SEED_PASSWORD_INSPECTOR=
SEED_PASSWORD_WAREHOUSE=
