PORT=5000
DATABASE_URL=postgresql://seedflow:seedflow@localhost:5433/seedflow
NODE_ENV=development

# Change this in any real deployment.
JWT_ACCESS_SECRET=dev-access-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

FRONTEND_ORIGIN=http://localhost:5173

# --- AI assistant (optional) ---
# Leave AI_API_KEY empty to run the assistant in deterministic mode: it still
# answers from real database queries, just without an external model.
# AI_PROVIDER accepts: anthropic | openai | gemini
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_MAX_CONTEXT_ROWS=40
